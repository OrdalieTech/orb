#!/bin/bash
# Runs the agent as `agent` and, for Buzz, buzz-acp as `buzz`. The agent gets
# its credentials on descriptors, never in its environment or in a file its
# tools could open: the variables below as KEY=VALUE lines on fd 3, auth.json
# (OAuth logins) on fd 4. The first process to exit ends the container with its
# status, so an owner's !shutdown (a clean buzz-acp exit) stays final under
# --restart on-failure.
set -u
trap 'kill -TERM $(jobs -p) 2>/dev/null' TERM INT
plain=() secrets=() buzz=()
while IFS= read -r variable; do
  if [[ $variable =~ ^(PATH|HOME|TERM|LANG|LC_[A-Z]+|TZ|ORB_[A-Z_]+|PI_[A-Z_]+)= ]]; then
    plain+=("$variable")
  else
    secrets+=("$variable")
  fi
  if [[ $variable =~ ^(BUZZ_[A-Z_]+|RUST_LOG)= ]]; then buzz+=("$variable"); fi
done < <(env)

auth=/agent/secrets/auth.json
install -d -o root -g root -m 0700 /agent/secrets
if [ -f /agent/config/auth.json ] && [ ! -f "$auth" ]; then mv /agent/config/auth.json "$auth"; fi
touch "$auth" && chown root:root "$auth" && chmod 0600 "$auth"
exec 4<>"$auth"
setpriv --reuid=agent --regid=agent --init-groups env -i "${plain[@]}" ORB_SECRETS_FD=3 ORB_AUTH_FD=4 \
  orb chat "$@" 3<<<"$(printf '%s\n' "${secrets[@]}")" &
exec 4>&-

if [[ " $* " == *" buzz "* ]]; then
  # buzz-acp starts its agent (nc on Orb's socket) at once, so the socket comes first.
  for _ in $(seq 300); do [ -S "$ORB_ACP_SOCKET" ] && break; sleep 0.1; done
  setpriv --reuid=buzz --regid=buzz --init-groups env -i PATH="$PATH" HOME=/home/buzz "${buzz[@]}" buzz-acp &
fi
wait -n
status=$?
kill -TERM $(jobs -p) 2>/dev/null
wait
exit "$status"
