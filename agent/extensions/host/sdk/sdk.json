{
	"name": "orb-extension-sdk",
	"version": "1.0.0",
	"description": "Orb's embedded implementation of the @earendil-works/pi-* extension SDK surface. Materialized from the orb binary; never installed from npm.",
	"upstream": {
		"package": "pi",
		"version": "1.0.0",
		"commit": "a13d35a7",
		"license": "MIT"
	},
	"capabilities": {
		"sdk_v1": {
			"description": "Pure local symbols: no host protocol involved."
		},
		"agent_session_v1": {
			"description": "Child agent sessions bridged to the Go runtime.",
			"exports": ["coding-agent#createAgentSession"],
			"seam": [
				"agentSessionCreate",
				"agentSessionPrompt",
				"agentSessionAbort",
				"agentSessionSetActiveTools",
				"agentSessionDispose"
			]
		},
		"model_runtime_v1": {
			"description": "Model catalog and auth snapshot bridged to the Go runtime.",
			"exports": ["coding-agent#ModelRuntime", "coding-agent#ModelRegistry"],
			"seam": ["modelRuntimeCreate", "modelRuntimeRefresh", "modelRuntimeDispose"]
		}
	},
	"modules": {
		"coding-agent": {
			"implemented": [
				"DefaultResourceLoader",
				"ModelRegistry",
				"ModelRuntime",
				"SessionManager",
				"SettingsManager",
				"createAgentSession",
				"createCodingTools",
				"defineTool",
				"detectSupportedImageMimeTypeFromFile",
				"getAgentDir",
				"getLanguageFromPath",
				"getMarkdownTheme",
				"parseFrontmatter",
				"renderDiff"
			]
		},
		"ai": {
			"implemented": ["modelsAreEqual"]
		},
		"tui": {
			"implemented": [
				"Container",
				"Markdown",
				"SelectList",
				"Spacer",
				"Text",
				"parseKey",
				"truncateToWidth",
				"visibleWidth",
				"wrapTextWithAnsi",
				"backgroundAnsi",
				"colorToHex",
				"colorToOkhsl",
				"colorToOklch",
				"colorToRgb",
				"foregroundAnsi",
				"getTerminalColorMode",
				"indexedColor",
				"mixColors",
				"okhslColor",
				"oklabToOkhslLightness",
				"oklchColor",
				"parseColor",
				"rgbColor",
				"styleText",
				"styleTextWithAnsi"
			]
		}
	}
}
